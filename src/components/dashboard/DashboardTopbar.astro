---
const { user } = Astro.locals;
const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/favorites", label: "Ulubione" },
];
---

<header
  class="border-border bg-card/80 flex shrink-0 items-center gap-2 border-b px-3 py-2.5 backdrop-blur-sm sm:gap-3 sm:px-4"
>
  <div class="flex shrink-0 items-center gap-2">
    <!-- Steam bowl icon: always visible -->
    <div
      class="bg-primary/10 border-primary/25 text-primary flex h-7 w-7 items-center justify-center rounded-lg border"
    >
      <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d="M3 12C3 16 6 18.5 10 18.5C14 18.5 17 16 17 12"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          fill="none"></path>
        <path d="M2.5 12H17.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
        <path
          d="M6.5 11Q5.5 8.5 6.5 6Q7.5 3.5 6.5 2"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          fill="none"></path>
        <path
          d="M10 11Q9 8.5 10 6Q11 3.5 10 2"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          fill="none"></path>
        <path
          d="M13.5 11Q12.5 8.5 13.5 6Q14.5 3.5 13.5 2"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          fill="none"></path>
      </svg>
    </div>
    <!-- Wordmark: always visible, two-tone -->
    <span class="text-foreground shrink-0 text-lg font-bold tracking-wide">
      Meal<span class="text-primary">Draft</span>
    </span>
  </div>
  <!-- Divider + nav: desktop only (mobile nav moves to bottom bar) -->
  <div class="bg-border/60 hidden h-4 w-px shrink-0 md:block"></div>
  <nav class="hidden min-w-0 flex-1 items-center gap-0.5 text-xs md:flex" aria-label="Główna nawigacja">
    {
      navLinks.map((link) => {
        const isActive = pathname === link.href || pathname.startsWith(`${link.href}/`);
        return (
          <a
            href={link.href}
            class:list={[
              "rounded px-2 py-1 font-medium tracking-wide transition-colors sm:px-2.5 sm:py-1.5",
              isActive
                ? "bg-primary/15 text-primary ring-primary/30 ring-1"
                : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>
  <!-- Spacer on mobile so logout stays right-aligned -->
  <div class="flex-1 md:hidden"></div>
  <div class="flex shrink-0 items-center gap-2">
    {user && <span class="text-muted-foreground/60 hidden text-xs sm:inline">{user.email}</span>}
    <form method="POST" action="/api/auth/signout">
      <button
        type="submit"
        title="Wyloguj"
        aria-label="Wyloguj"
        class="border-border/70 bg-muted/60 text-muted-foreground hover:border-border hover:bg-accent hover:text-accent-foreground flex h-8 w-8 items-center justify-center rounded-lg border transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      </button>
    </form>
  </div>
</header>
