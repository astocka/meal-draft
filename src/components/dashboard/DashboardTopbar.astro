---
const { user } = Astro.locals;
const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/favorites", label: "Ulubione" },
];
---

<header
  class="border-border bg-card/80 flex shrink-0 items-center gap-2 border-b px-3 py-2.5 backdrop-blur-sm sm:gap-3 sm:px-4"
>
  <span class="text-primary shrink-0 text-xs font-bold tracking-widest uppercase sm:text-sm">MealDraft</span>
  <div class="bg-border/60 hidden h-4 w-px shrink-0 sm:block"></div>
  <nav class="flex min-w-0 flex-1 items-center gap-0.5 text-xs" aria-label="Główna nawigacja">
    {
      navLinks.map((link) => {
        const isActive = pathname === link.href || pathname.startsWith(`${link.href}/`);
        return (
          <a
            href={link.href}
            class:list={[
              "rounded px-2 py-1 font-medium tracking-wide transition-colors sm:px-2.5 sm:py-1.5",
              isActive
                ? "bg-primary/15 text-primary ring-primary/30 ring-1"
                : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>
  <div class="flex shrink-0 items-center gap-2">
    {user && <span class="text-muted-foreground/60 hidden text-xs sm:inline">{user.email}</span>}
    <form method="POST" action="/api/auth/signout">
      <button
        type="submit"
        class="border-border/70 bg-muted/60 text-muted-foreground hover:border-border hover:bg-accent hover:text-accent-foreground rounded border px-2 py-1 text-xs font-medium transition-colors sm:px-2.5 sm:py-1.5"
      >
        Wyloguj
      </button>
    </form>
  </div>
</header>
