---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={`flex items-center gap-3 ${className ?? ""}`}>
  <div class="bg-primary/10 border-primary/25 flex h-10 w-10 items-center justify-center rounded-xl border">
    <svg
      class="text-primary"
      width="20"
      height="20"
      viewBox="0 0 20 20"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- Bowl -->
      <path
        d="M3 12C3 16 6 18.5 10 18.5C14 18.5 17 16 17 12"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        fill="none"></path>
      <path d="M2.5 12H17.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
      <!-- Steam: 3 wavy S-curves -->
      <path
        d="M6.5 11Q5.5 8.5 6.5 6Q7.5 3.5 6.5 2"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        fill="none"></path>
      <path
        d="M10 11Q9 8.5 10 6Q11 3.5 10 2"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        fill="none"></path>
      <path
        d="M13.5 11Q12.5 8.5 13.5 6Q14.5 3.5 13.5 2"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        fill="none"></path>
    </svg>
  </div>
  <span class="text-foreground text-2xl font-bold tracking-wide">
    Meal<span class="text-primary">Draft</span>
  </span>
</div>
