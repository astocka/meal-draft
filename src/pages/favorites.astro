---
import Layout from "@/layouts/Layout.astro";
import DashboardTopbar from "@/components/dashboard/DashboardTopbar.astro";
import BottomNav from "@/components/dashboard/BottomNav.astro";
import Footer from "@/components/Footer.astro";
import FavoritesShell from "@/components/favorites/FavoritesShell.tsx";
import { createClient } from "@/lib/supabase";
import type { FavoriteMeal } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;
let initialItems: FavoriteMeal[] = [];
let loadError = false;

if (supabase && user) {
  const { data, error } = await supabase
    .from("favorite_meals")
    .select("*")
    .eq("user_id", user.id)
    .order("saved_at", { ascending: false });
  if (error) {
    loadError = true;
    // eslint-disable-next-line no-console -- server-side prefetch failure logging
    console.error("[favorites] prefetch failed:", error.message);
  }
  initialItems = (data as FavoriteMeal[] | null) ?? [];
} else if (user) {
  loadError = true;
}
---

<Layout title="Ulubione — MealDraft">
  <div class="bg-background text-foreground flex h-dvh flex-col overflow-hidden">
    <DashboardTopbar />
    <main class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden">
      <FavoritesShell client:load initialItems={initialItems} loadError={loadError} />
    </main>
    <Footer />
    <BottomNav />
  </div>
</Layout>
