---
import Layout from "@/layouts/Layout.astro";
import DashboardTopbar from "@/components/dashboard/DashboardTopbar.astro";
import MealGeneratorPlaceholder from "@/components/meal/MealGeneratorPlaceholder.astro";
import PantryWidget from "@/components/pantry/PantryWidget.tsx";
import { createClient } from "@/lib/supabase";
import type { PantryProduct } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
let initialItems: PantryProduct[] = [];

if (supabase) {
  const { data } = await supabase.from("pantry_products").select("*").order("name", { ascending: true });
  initialItems = (data as PantryProduct[] | null) ?? [];
}
---

<Layout title="Dashboard — MealDraft">
  <div class="bg-cosmic flex h-full min-h-screen flex-col text-white">
    <DashboardTopbar />
    <main class="grid min-h-0 flex-1 grid-cols-1 md:grid-cols-2">
      <div class="flex min-h-0 flex-col border-b border-white/10 md:border-r md:border-b-0">
        <div class="shrink-0 border-b border-white/10 px-5 py-3">
          <h2 class="text-sm font-semibold tracking-widest text-white/40 uppercase">My Pantry</h2>
        </div>
        <div class="min-h-0 flex-1 overflow-hidden">
          <PantryWidget client:load initialItems={initialItems} />
        </div>
      </div>
      <div class="hidden min-h-0 flex-col md:flex">
        <MealGeneratorPlaceholder />
      </div>
    </main>
  </div>
</Layout>
