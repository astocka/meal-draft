---
import Layout from "@/layouts/Layout.astro";
import DashboardTopbar from "@/components/dashboard/DashboardTopbar.astro";
import DashboardShell from "@/components/dashboard/DashboardShell.tsx";
import { createClient } from "@/lib/supabase";
import type { PantryProduct } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;
let initialItems: PantryProduct[] = [];
let loadError = false;

if (supabase && user) {
  const { data, error } = await supabase
    .from("pantry_products")
    .select("*")
    .eq("user_id", user.id)
    .order("name", { ascending: true });
  if (error) {
    loadError = true;
    // eslint-disable-next-line no-console -- server-side prefetch failure logging
    console.error("[dashboard] pantry prefetch failed:", error.message);
  }
  initialItems = (data as PantryProduct[] | null) ?? [];
}
---

<Layout title="Dashboard — MealDraft">
  <div class="bg-background text-foreground flex h-full min-h-screen flex-col">
    <DashboardTopbar />
    <main class="flex min-h-0 flex-1 flex-col">
      <DashboardShell client:load initialItems={initialItems} loadError={loadError} />
    </main>
  </div>
</Layout>
