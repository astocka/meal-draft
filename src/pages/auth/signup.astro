---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Rejestracja">
  <div class="bg-background flex min-h-screen flex-col items-center justify-center gap-6 p-4">
    <p class="text-primary text-center text-3xl font-bold tracking-wide">MealDraft</p>
    <div class="border-border bg-card w-full max-w-sm rounded-2xl border p-8 shadow-sm">
      <h1 class="text-card-foreground mb-6 text-center text-2xl font-bold">Rejestracja</h1>
      <SignUpForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Masz już konto? <a href="/auth/signin" class="text-primary hover:underline">Zaloguj się</a>
      </p>
    </div>
  </div>
</Layout>
