---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
---

<Layout title="Logowanie">
  <div
    class="bg-background flex min-h-screen flex-col items-center justify-start gap-5 p-5 pt-16 sm:justify-center sm:pt-5"
  >
    <p class="text-primary text-center text-2xl font-bold tracking-widest uppercase">MealDraft</p>
    <div class="border-border/50 bg-card w-full max-w-sm rounded-2xl border p-7 shadow-lg shadow-black/30">
      <h1 class="text-card-foreground mb-5 text-center text-lg font-semibold">Logowanie</h1>
      {
        success && (
          <p class="bg-primary/10 border-primary/20 text-foreground mb-4 rounded-xl border px-4 py-2.5 text-center text-xs">
            {success}
          </p>
        )
      }
      <SignInForm serverError={error} client:load />
      <p class="text-muted-foreground mt-5 text-center text-xs">
        Nie masz konta? <a href="/auth/signup" class="text-primary hover:underline">Zarejestruj się</a>
      </p>
    </div>
  </div>
</Layout>
