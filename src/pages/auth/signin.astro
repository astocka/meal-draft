---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
---

<Layout title="Logowanie">
  <div class="bg-cosmic flex min-h-screen flex-col items-center justify-center gap-6 p-4">
    <p
      class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-3xl font-bold tracking-wide text-transparent"
    >
      MealDraft
    </p>
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Logowanie
      </h1>
      {success && <p class="mb-4 rounded-lg bg-green-500/20 px-4 py-2 text-center text-sm text-green-200">{success}</p>}
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Nie masz konta? <a href="/auth/signup" class="text-purple-300 hover:underline">Zarejestruj się</a>
      </p>
    </div>
  </div>
</Layout>
