---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import AppLogo from "@/components/AppLogo.astro";

const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
---

<Layout title="Logowanie">
  <div
    class="bg-background flex min-h-screen flex-col items-center justify-start gap-6 p-4 pt-12 sm:justify-center sm:pt-4"
  >
    <AppLogo />
    <div class="border-border bg-card w-full max-w-sm rounded-2xl border p-8 shadow-sm">
      <h1 class="text-card-foreground mb-6 text-center text-2xl font-bold">Logowanie</h1>
      {
        success && (
          <p class="bg-primary/10 border-primary/20 text-foreground mb-4 rounded-xl border px-4 py-2.5 text-center text-sm">
            {success}
          </p>
        )
      }
      <SignInForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Nie masz konta? <a href="/auth/signup" class="text-primary hover:underline">Zarejestruj się</a>
      </p>
    </div>
  </div>
</Layout>
