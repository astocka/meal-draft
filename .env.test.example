# Copy to .env.test and fill from your local Supabase project.
# URL + anon key: `supabase status` (local CLI) or Project Settings → API (hosted).
#
# GitHub Actions (Tier 2 integration + Tier 3 E2E): add all six vars as repository secrets.
# Use a dedicated hosted CI/test Supabase project — not production — with test users A/B created.
#
# **Whenever a new DB migration is added under `supabase/migrations/`, it must be manually
# applied to the hosted CI Supabase project before merging to `main`.** Tier 2/3 depend on schema parity.
SUPABASE_URL=
SUPABASE_KEY=

# Dedicated test users — use secure passwords; emails must be unique in your project.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
