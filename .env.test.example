# Copy to .env.test and fill from your local Supabase project.
# URL + anon key: `supabase status` (local CLI) or Project Settings → API (hosted).
SUPABASE_URL=
SUPABASE_KEY=

# Dedicated test users — use secure passwords; emails must be unique in your project.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
