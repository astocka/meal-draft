# Required — OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional — model id on OpenRouter (default: openai/gpt-4.1-nano)
# REVIEW_MODEL=openai/gpt-4.1-nano

# Smoke-test model connectivity (no diff required):
#   pnpm run ping

# Optional — repo root when AGENTS.md is not found from cwd
# (first existing path wins: MEALDRAFT_ROOT, PROJECT_ROOT, cwd, then ../../ from package)
# MEALDRAFT_ROOT=
# PROJECT_ROOT=
