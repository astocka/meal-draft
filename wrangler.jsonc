{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meal-draft",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // Run `wrangler kv namespace create RATE_LIMIT` to get a real ID for production.
  // For local preview (Miniflare), any non-empty string works as the id.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "7cdbbebb93ce40afa66d2a74a13c3b8e",
    },
  ],
}
